# InsightHub configuration — copy to `.env` and adjust. Never commit `.env`.
# The backend reads these from the environment (run.sh / run.ps1 load `.env`).

# ---------------------------------------------------------------------------
# Auth (REQUIRED in any real deployment)
# ---------------------------------------------------------------------------
# Secret used to sign JWTs. MUST be a long random string in production.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
IH_SECRET_KEY=change-me-to-a-long-random-secret
# JWT lifetime in minutes (default 720 = 12h)
# IH_JWT_TTL_MINUTES=720

# ---------------------------------------------------------------------------
# LLM provider — used for the "Ask" answers and the AI narrative.
# The whole app is provider-agnostic; pick ONE.
# ---------------------------------------------------------------------------
# Leave everything blank to run fully OFFLINE (deterministic fallbacks, no key,
# no network). Good for local demos and CI.
# IH_OFFLINE=1

# Otherwise set the provider and its key. Options:
#   anthropic | openai | gemini | ollama | groq | openrouter | together
# IH_LLM_PROVIDER=anthropic
# IH_MODEL=                      # optional; sensible per-provider default if unset

# --- provider API keys (set the one matching IH_LLM_PROVIDER) ---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# OPENROUTER_API_KEY=...
# TOGETHER_API_KEY=...
# (Ollama is local and needs no key — just run `ollama serve`)

# Advanced: point at any OpenAI-compatible endpoint / self-hosted model.
# IH_LLM_API_KEY=...             # overrides the provider-specific key above
# IH_LLM_BASE_URL=http://localhost:11434/v1

# Examples:
#   Claude:   IH_LLM_PROVIDER=anthropic   ANTHROPIC_API_KEY=sk-ant-...   IH_MODEL=claude-sonnet-4-6
#   OpenAI:   IH_LLM_PROVIDER=openai      OPENAI_API_KEY=sk-...          IH_MODEL=gpt-4o-mini
#   Gemini:   IH_LLM_PROVIDER=gemini      GEMINI_API_KEY=...             IH_MODEL=gemini-1.5-pro
#   Ollama:   IH_LLM_PROVIDER=ollama                                     IH_MODEL=llama3.1   (free, local)

# ---------------------------------------------------------------------------
# Production hardening (recommended before exposing beyond localhost)
# ---------------------------------------------------------------------------
# Set to "production" to fail-fast on the insecure default secret / unset CORS.
# IH_ENV=production
# CORS allow-list — your exact frontend origin(s), comma-separated.
# Empty falls back to a permissive localhost regex (dev only).
# IH_CORS_ORIGINS=https://app.example.com
# Rate limits: requests per IP per 60s window (0-window tune via IH_RATELIMIT_WINDOW).
# IH_RATELIMIT_ENABLED=1
# IH_RATELIMIT_AUTH=15                   # login/signup (brute-force guard)
# IH_RATELIMIT_LLM=40                    # ask/query/narrative
# IH_RATELIMIT_PUBLIC=120               # public share links
# IH_RATELIMIT_DEFAULT=400
# Trust X-Forwarded-For for the client IP (ONLY behind a proxy you control).
# IH_TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Live data sources & alerts (optional)
# ---------------------------------------------------------------------------
# Allow syncing/webhooks to private/internal URLs (off by default — SSRF guard).
# IH_ALLOW_PRIVATE_FETCH=1
# Background auto-refresh scheduler for live sources + alerts (on by default).
# IH_ENABLE_SCHEDULER=1

# ---------------------------------------------------------------------------
# Billing / plan gating (optional — off by default = everything unlimited)
# ---------------------------------------------------------------------------
# IH_BILLING_ENABLED=1
# IH_STRIPE_SECRET_KEY=sk_live_or_test_...
# IH_STRIPE_WEBHOOK_SECRET=whsec_...      # verifies POST /api/billing/webhook
# IH_STRIPE_PRICE_PRO=price_...           # Stripe Price id for the Pro plan

# ---------------------------------------------------------------------------
# Storage & limits (optional)
# ---------------------------------------------------------------------------
# Storage backend. Unset = single-file DuckDB (zero-config, great for dev).
# Set a Postgres URL to store everything in Postgres (durable + concurrent);
# DuckDB stays the query engine and ATTACHes to it, so the same SQL runs.
# IH_DATABASE_URL=postgresql://insighthub:insighthub@localhost:5544/insighthub
# IH_DB=data/insighthub.duckdb          # DuckDB file path (when IH_DATABASE_URL unset)
# IH_MAX_UPLOAD_BYTES=52428800          # 50 MB upload cap
# IH_DATA_DIR=data
# IH_DB_POOL=1                          # reuse one DB connection per worker thread (default on)
