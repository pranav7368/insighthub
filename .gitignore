messy_sales.csv
new_month.csv
sample_company_sales.csv
sample_policy.txt
*.local.csv

# ─────────────────────────────  OS / editor  ─────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

